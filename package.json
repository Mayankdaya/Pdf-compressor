    "express": "^4.18.2",
    "lucide-react": "^0.555.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
